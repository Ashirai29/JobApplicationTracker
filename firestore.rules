rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validApplication(data) {
        return data.keys().hasOnly([
            'title',
            'company',
            'status',
            'location',
            'jobUrl',
            'appliedOn',
            'nextAction',
            'nextActionDate',
            'notes',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasAll([
            'title',
            'company',
            'status',
            'location',
            'jobUrl',
            'appliedOn',
            'nextAction',
            'nextActionDate',
            'notes',
            'createdAt',
            'updatedAt'
          ])
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 160
          && data.company is string
          && data.company.size() > 0
          && data.company.size() <= 160
          && data.status in [
            'Saved',
            'Preparing',
            'Applied',
            'Assessment',
            'Interview',
            'Offer',
            'Accepted',
            'Rejected',
            'Withdrawn',
            'Archived'
          ]
          && data.location is string
          && data.location.size() <= 160
          && data.jobUrl is string
          && data.jobUrl.size() <= 2048
          && (
            data.jobUrl == ''
            || data.jobUrl.matches('https?://.*')
          )
          && data.appliedOn is string
          && data.appliedOn.size() <= 10
          && (
            data.appliedOn == ''
            || data.appliedOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          )
          && data.nextAction is string
          && data.nextAction.size() <= 240
          && data.nextActionDate is string
          && data.nextActionDate.size() <= 10
          && (
            data.nextActionDate == ''
            || data.nextActionDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          )
          && data.notes is string
          && data.notes.size() <= 10000
          && data.createdAt is number
          && data.updatedAt is number;
      }

      function validTask(data) {
        return data.keys().hasOnly([
            'title',
            'dueDate',
            'applicationId',
            'completed',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasAll([
            'title',
            'dueDate',
            'applicationId',
            'completed',
            'createdAt',
            'updatedAt'
          ])
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 240
          && data.dueDate is string
          && data.dueDate.size() <= 10
          && (
            data.dueDate == ''
            || data.dueDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          )
          && data.applicationId is string
          && data.applicationId.size() <= 128
          && data.completed is bool
          && data.createdAt is number
          && data.updatedAt is number
          && (
            data.applicationId == ''
            || exists(/databases/$(database)/documents/users/$(userId)/applications/$(data.applicationId))
          );
      }

      allow read, write: if isOwner();

      match /applications/{applicationId} {
        allow read: if isOwner();
        allow create: if isOwner() && validApplication(request.resource.data);
        allow update: if isOwner()
          && validApplication(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;

        match /events/{eventId} {
          allow read: if isOwner();
          allow create: if isOwner()
            && request.resource.data.keys().hasOnly([
              'type',
              'description',
              'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'type',
              'description',
              'createdAt'
            ])
            && request.resource.data.type in [
              'created',
              'status_changed',
              'updated'
            ]
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 300
            && request.resource.data.createdAt is number;
          allow update, delete: if false;
        }
      }

      match /tasks/{taskId} {
        allow read: if isOwner();
        allow create: if isOwner() && validTask(request.resource.data);
        allow update: if isOwner()
          && validTask(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }
  }
}
